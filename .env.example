# Copy to .env (gitignored) and fill in. NEVER commit real values.
# AWS is used for GPU training only. Prefer ~/.aws/credentials + a profile.
AWS_PROFILE=uball
AWS_DEFAULT_REGION=us-east-1
UBALL_S3_BUCKET=uball-videos-production

# ⚠️ The AWS keys used in prior projects are flagged for ROTATION.
# Rotate them, then place the new keys ONLY in ~/.aws/credentials or this
# gitignored .env — never in a tracked file.
# AWS_ACCESS_KEY_ID=__set_in_local_env_only__
# AWS_SECRET_ACCESS_KEY=__set_in_local_env_only__

# VLM (narration) — set whichever provider you use; keep in .env only.
# GEMINI_API_KEY=__set_in_local_env_only__
# ANTHROPIC_API_KEY=__set_in_local_env_only__
